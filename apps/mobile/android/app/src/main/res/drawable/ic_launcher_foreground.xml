<?xml version="1.0" encoding="utf-8"?>
<!--
  BLE Vault app icon — redesign v2.
  Viewport: 1024x1024.
  Design: Large filled lime-green shield (#8FC322) with a dark padlock
          shape cut out from the centre. Bold, readable at any size.
  Background layer provides #0F0F0F fill.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Shield (filled lime green, inset ~80px from edges) -->
    <path
        android:fillColor="#8FC322"
        android:pathData="M 512,250
                          L 740,375
                          L 740,570
                          Q 740,735 512,840
                          Q 284,735 284,570
                          L 284,375 Z" />

    <!-- Lock shackle cutout (dark stroke = U-shaped arch above body) -->
    <!--   inner gap 180px, stroke 52px → outer width 232px matching body -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#0F0F0F"
        android:strokeWidth="52"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 422,528 L 422,444 A 90,90 0 0,1 602,444 L 602,528" />

    <!-- Lock body cutout (dark filled rounded rect) -->
    <!--   x=396 y=514 w=232 h=212 rx=36 -->
    <path
        android:fillColor="#0F0F0F"
        android:pathData="M 432,514
                          h 160
                          a 36,36 0 0,1 36,36
                          v 140
                          a 36,36 0 0,1 -36,36
                          h -160
                          a 36,36 0 0,1 -36,-36
                          v -140
                          a 36,36 0 0,1 36,-36 z" />

    <!-- Keyhole dot (lime green accent inside dark body) -->
    <path
        android:fillColor="#8FC322"
        android:pathData="M 548,618 a 36,36 0 1,1 -72,0 a 36,36 0 1,1 72,0" />

</vector>
